# ============================================================
# ReactivIQ Backend — Environment Variables
# Copy to .env and fill in values. Never commit .env.
# ============================================================

# App
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string

# Database — local PostgreSQL 18 with PGVector
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/CRM_Reactivation
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# Redis (Celery broker + result backend)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── AI Providers ──────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
COHERE_API_KEY=...

# LiteLLM proxy (optional — leave blank to call providers directly)
LITELLM_PROXY_URL=

# ── Azure OpenAI ──────────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_DEPLOYMENT_GPT41_MINI=gpt-4.1-mini
AZURE_DEPLOYMENT_GPT5_NANO=gpt-5-nano
AZURE_DEPLOYMENT_EMBEDDINGS=text-embedding-3-small

# ── Observability ─────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Auth — Clerk ──────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://<your-clerk-domain>/.well-known/jwks.json

# ── Integrations ──────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@reactiviq.ai

TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1...

HUBSPOT_API_KEY=...
HUBSPOT_PORTAL_ID=

CALENDLY_API_KEY=

# ── RAG / Embeddings ─────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
SIMILARITY_THRESHOLD=0.5

# ── API Keys (internal) ───────────────────────────────────
API_KEY_PREFIX=riq_live_sk_
